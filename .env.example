# Neon injects this automatically when deployed through the Vercel integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# pnpm test:integration / test:e2e create a random isolated schema via DATABASE_URL.

# Better Auth signs the web session and ChatGPT OAuth tokens with this secret.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public origin only (no /api/auth suffix). Production must use HTTPS.
# Set explicitly on Production. Real OAuth login is not supported on arbitrary Preview URLs.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth local callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth local callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# This is the only value intentionally exposed to browser JavaScript.
NEXT_PUBLIC_APP_NAME=AimThread
