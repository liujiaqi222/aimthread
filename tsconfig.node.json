{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/service/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "test/**/*"
  ],
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@service/*": ["src/service/*"],
      "@main/*": ["src/main/*"]
    }
  }
}
