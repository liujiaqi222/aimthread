{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite.web.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/service/**/*",
    "src/shared/**/*",
    "src/ui/client/**/*",
    "src/ui/vite-env.d.ts",
    "scripts/**/*",
    "test/**/*"
  ],
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@service/*": ["src/service/*"],
      "@main/*": ["src/main/*"],
      "@ui/*": ["src/ui/*"]
    }
  }
}
